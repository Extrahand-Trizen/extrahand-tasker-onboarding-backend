# Server Configuration
NODE_ENV=development
PORT=4006

# MongoDB
MONGODB_URI=mongodb://localhost:27017/extrahand
MONGO_DB=extrahand

# Firebase (Legacy - for tasker accounts only)
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your-project.iam.gserviceaccount.com

# Service Authentication (inter-service communication)
SERVICE_AUTH_TOKEN=your_super_secret_token_min_32_chars_long_12345

# JWT Authentication (for admin users)
JWT_SECRET=your_jwt_secret_min_32_chars_long_change_in_production_12345
JWT_REFRESH_SECRET=your_jwt_refresh_secret_min_32_chars_long_change_in_production_12345

# Microsoft OAuth (for admin authentication)
# Create app at: https://portal.azure.com/#blade/Microsoft_AAD_RegisteredApps/ApplicationsListBlade
MICROSOFT_CLIENT_ID=your-microsoft-client-id
MICROSOFT_CLIENT_SECRET=your-microsoft-client-secret
MICROSOFT_REDIRECT_URI=http://localhost:4006/api/v1/auth/microsoft/callback

# Frontend URL
# Comma-separated list of allowed origins for CORS
# Example: http://localhost:3000,https://partner.extrahand.in
CORS_ORIGIN=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# Service URLs (optional)
USER_SERVICE_URL=http://localhost:4005
VERIFICATION_SERVICE_URL=http://localhost:4008
EMAIL_SERVICE_URL=http://localhost:4007

# Logging
LOG_LEVEL=info
MONGODB_URI=mongodb+srv://projectstrizen_db_user:trizen123@cluster0.f0cebtz.mongodb.net/extrahand?retryWrites=true&w=majority
