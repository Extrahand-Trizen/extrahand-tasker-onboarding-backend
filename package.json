{
  "name": "extrahand-admin-service",
  "version": "1.0.0",
  "description": "Admin service for bulk operations and management",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "prod": "NODE_ENV=production node dist/server.js",
    "migrate:lead-status": "node scripts/migrate-lead-status-values.js",
    "migrate:rejected-to-inactive": "node scripts/migrate-rejected-to-inactive.js",
    "migrate:status-history-legacy": "node scripts/migrate-status-history-legacy-values.js",
    "migrate:addedby-uid-to-userid": "node scripts/migrate-qualifier-addedby-uid-to-userid.js",
    "validate:addedby-migration": "node scripts/validate-qualifier-addedby-migration.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@types/aws-sdk": "^0.0.42",
    "@types/bcrypt": "^6.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "aws-sdk": "^2.1693.0",
    "axios": "^1.6.0",
    "bcrypt": "^6.0.0",
    "bullmq": "^5.66.5",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "csv-parse": "^5.5.0",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "firebase-admin": "^12.5.0",
    "helmet": "^7.1.0",
    "ioredis": "^5.9.2",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.8.0",
    "morgan": "^1.10.0",
    "multer": "^2.0.0",
    "uuid": "^9.0.1",
    "winston": "^3.11.0",
    "xlsx": "^0.18.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/ioredis": "^4.28.10",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.10.6",
    "@types/uuid": "^9.0.8",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.3"
  }
}
